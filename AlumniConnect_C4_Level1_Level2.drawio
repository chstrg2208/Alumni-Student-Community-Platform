<mxfile host="Electron" modified="2026-10-08T03:30:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <!-- PAGE 1: C4 LEVEL 1 - SYSTEM CONTEXT -->
  <diagram id="c4_level_1" name="C4 Level 1 - System Context">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title1" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;C4 Model Level 1: System Context Diagram&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Dự án: Alumni Connect Platform | Phụ trách kiến trúc: Nguyễn Chí Trung&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Person: Student -->
        <mxCell id="student" value="&lt;b&gt;Sinh viên (Student)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Sinh viên trường FPT tìm kiếm cơ hội học bổng, việc làm, định hướng nghề nghiệp và kết nối với cựu sinh viên." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052D56;fontColor=#ffffff;arcSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Person: Alumni -->
        <mxCell id="alumni" value="&lt;b&gt;Cựu sinh viên (Alumni)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Cựu sinh viên chia sẻ kinh nghiệm thực tế, cơ hội việc làm, làm mentor và trò chuyện tư vấn định hướng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052D56;fontColor=#ffffff;arcSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="240" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Person: Admin -->
        <mxCell id="admin" value="&lt;b&gt;Quản trị viên (Admin)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Quản trị tài khoản, kiểm duyệt bài viết diễn đàn và giám sát hoạt động hệ thống." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052D56;fontColor=#ffffff;arcSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="90" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- System: Alumni Connect Platform -->
        <mxCell id="system" value="&lt;b&gt;Alumni Connect Platform&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Software System]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Nền tảng mạng xã hội kết nối sinh viên và cựu sinh viên. Cho phép chia sẻ bài viết theo nhóm ngành, không gian chung và nhắn tin real-time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="280" width="300" height="180" as="geometry" />
        </mxCell>

        <!-- External System: Google Identity -->
        <mxCell id="google" value="&lt;b&gt;Google Identity Provider&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Hệ thống xác thực tài khoản Google OAuth 2.0 của người dùng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;arcSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="550" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Relationships -->
        <mxCell id="rel_student_sys" value="Đăng ký, cập nhật profile,&lt;br/&gt;tìm kiếm cựu SV, nhắn tin&lt;br/&gt;&lt;i&gt;[HTTPS / WSS]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;strokeColor=#555555;strokeWidth=2;fontSize=11;align=center;" edge="1" parent="1" source="student" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_alumni_sys" value="Đăng nhập, chia sẻ bài,&lt;br/&gt;chat tư vấn, mentor&lt;br/&gt;&lt;i&gt;[HTTPS / WSS]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.35;strokeColor=#555555;strokeWidth=2;fontSize=11;align=center;" edge="1" parent="1" source="alumni" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_admin_sys" value="Quản lý thành viên,&lt;br/&gt;kiểm duyệt bài viết&lt;br/&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#555555;strokeWidth=2;fontSize=11;align=center;" edge="1" parent="1" source="admin" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_sys_google" value="Xác thực danh tính&lt;br/&gt;&lt;i&gt;[OAuth 2.0 / HTTPS]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#555555;strokeWidth=2;fontSize=11;align=center;" edge="1" parent="1" source="system" target="google">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 2: C4 LEVEL 2 - CONTAINER DIAGRAM -->
  <diagram id="c4_level_2" name="C4 Level 2 - Container Diagram">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;C4 Model Level 2: Container Diagram (Kiến trúc Microservices)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Làm nổi bật phạm vi của Nguyễn Chí Trung (User Service &amp;amp; Chat Service) trong hệ thống&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="15" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- USERS AT TOP -->
        <mxCell id="user_student" value="&lt;b&gt;Sinh viên (Student)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Person]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052D56;fontColor=#ffffff;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="user_alumni" value="&lt;b&gt;Cựu sinh viên (Alumni)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Person]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052D56;fontColor=#ffffff;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="user_admin" value="&lt;b&gt;Quản trị viên (Admin)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Person]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052D56;fontColor=#ffffff;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- CLIENT CONTAINERS -->
        <mxCell id="web_app" value="&lt;b&gt;Web Application (PRN)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: React / Blazor]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Giao diện Web cho sinh viên và cựu sinh viên duyệt diễn đàn, xem profile, chat.&lt;br/&gt;&lt;b&gt;(Phụ trách: Nguyễn Phương Khải)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="190" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="mobile_app" value="&lt;b&gt;Mobile Application (PRM)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Flutter / Kotlin]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Ứng dụng di động trên Android / iOS cho sinh viên nhận thông báo và chat tiện lợi.&lt;br/&gt;&lt;b&gt;(Phụ trách: Đỗ Trọng Tín)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="190" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- API GATEWAY -->
        <mxCell id="gateway" value="&lt;b&gt;API Gateway / Reverse Proxy&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: YARP / Ocelot / NGINX]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Điểm đón request tập trung, định tuyến API, SSL Termination và xác thực sơ bộ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="360" width="320" height="90" as="geometry" />
        </mxCell>

        <!-- BOUNDARY: CHÍ TRUNG SCOPE -->
        <mxCell id="boundary_trung" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;PHẠM VI ĐẢM NHIỆM BỞI NGUYỄN CHÍ TRUNG&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8FF;strokeColor=#0288D1;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="700" height="470" as="geometry" />
        </mxCell>

        <!-- UserService -->
        <mxCell id="user_service" value="&lt;b&gt;User Service&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: C# .NET 10 Web API - Port 5164]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Quản lý Đăng nhập Email/Google (US-01, 02), Xác minh Email (US-03), Hồ sơ cá nhân (US-04, 05), Tìm kiếm thành viên (US-06), Đổi/Quên mật khẩu (US-07), Logout &amp;amp; Blacklist Token (US-08), Quyền riêng tư (US-09), Chặn tài khoản (US-10)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="540" width="290" height="180" as="geometry" />
        </mxCell>

        <!-- User Database (PostgreSQL) -->
        <mxCell id="user_db" value="&lt;b&gt;User Database&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: PostgreSQL Database]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Lưu trữ bảng Users, PrivacySettings, BlockedUsers, InvalidatedTokens.&lt;br/&gt;&lt;b&gt;Database: alumni_user_db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2B5B84;strokeColor=#183D5C;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="125" y="780" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- ChatService -->
        <mxCell id="chat_service" value="&lt;b&gt;Chat Service&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: C# .NET 10 + SignalR - Port 5199]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Xử lý Chat real-time qua WebSocket Hub (/hubs/chat). Hỗ trợ chat 1-1 giữa SV và Cựu SV, chat nhóm ngành nghề và phòng chung toàn trường. Cung cấp REST API lấy lịch sử tin nhắn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="540" width="290" height="180" as="geometry" />
        </mxCell>

        <!-- Chat Database (PostgreSQL) -->
        <mxCell id="chat_db" value="&lt;b&gt;Chat Database&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: PostgreSQL Database]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Lưu trữ bảng Rooms (phòng chat), Members (thành viên phòng), Messages (lịch sử tin nhắn).&lt;br/&gt;&lt;b&gt;Database: alumni_chat_db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2B5B84;strokeColor=#183D5C;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="465" y="780" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- BOUNDARY: OTHER TEAM SERVICES -->
        <mxCell id="boundary_others" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;PHẠM VI THÀNH VIÊN KHÁC TRONG NHÓM&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#757575;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="490" width="630" height="470" as="geometry" />
        </mxCell>

        <!-- Forum Service -->
        <mxCell id="forum_service" value="&lt;b&gt;Forum Service&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Web API]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Quản lý bài viết, chuyên mục nhóm ngành, chia sẻ học bổng/việc làm.&lt;br/&gt;&lt;b&gt;(Phụ trách: Mai Tuấn Vinh)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#757575;strokeColor=#424242;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="540" width="250" height="140" as="geometry" />
        </mxCell>

        <!-- AI Service -->
        <mxCell id="ai_service" value="&lt;b&gt;AI Service&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Python / FastApi]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Gợi ý bài viết phù hợp cho sinh viên, tự động lọc nội dung spam.&lt;br/&gt;&lt;b&gt;(Phụ trách: Mai Tuấn Vinh)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#757575;strokeColor=#424242;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="540" width="250" height="140" as="geometry" />
        </mxCell>

        <!-- Admin Service -->
        <mxCell id="admin_service" value="&lt;b&gt;Admin Service&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[Container: Web API]&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Dashboard quản trị, duyệt bài viết, kiểm soát báo cáo vi phạm.&lt;br/&gt;&lt;b&gt;(Phụ trách: Nhóm trưởng)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#757575;strokeColor=#424242;fontColor=#ffffff;arcSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="740" width="280" height="140" as="geometry" />
        </mxCell>

        <!-- EXTERNAL: Google -->
        <mxCell id="ext_google2" value="&lt;b&gt;Google Identity&lt;/b&gt;&lt;br/&gt;&lt;i&gt;[External System]&lt;/i&gt;&lt;br/&gt;OAuth 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;arcSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- CONNECTIONS -->
        <!-- User to Apps -->
        <mxCell id="c_u_web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="user_student" target="web_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_u_mob" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="user_student" target="mobile_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a_web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="user_alumni" target="web_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a_mob" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="user_alumni" target="mobile_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_adm_web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="user_admin" target="web_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Apps to Gateway -->
        <mxCell id="c_web_gtw" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="web_app" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_mob_gtw" value="HTTPS / WSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="mobile_app" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gateway to Services -->
        <mxCell id="c_gtw_user" value="REST [Port 5164]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0288D1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gateway" target="user_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_gtw_chat" value="REST &amp;amp; WebSocket [Port 5199]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0288D1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gateway" target="chat_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_gtw_forum" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gateway" target="forum_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_gtw_admin" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gateway" target="admin_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Services to DBs -->
        <mxCell id="c_user_db" value="EF Core / Npgsql [Port 5432]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#183D5C;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="user_service" target="user_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_chat_db" value="EF Core / Npgsql [Port 5432]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#183D5C;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="chat_service" target="chat_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inter-service communications -->
        <mxCell id="c_user_google" value="OAuth 2.0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="user_service" target="ext_google2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_forum_user" value="Gọi API lấy Avatar/Tên tác giả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#E65100;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="forum_service" target="user_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_chat_user" value="Xác thực JWT Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#0288D1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="chat_service" target="user_service">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="600" />
              <mxPoint x="410" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
